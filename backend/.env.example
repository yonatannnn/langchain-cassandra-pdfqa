# Flask
FLASK_ENV=development
FLASK_DEBUG=1
PORT=8000
CORS_ORIGINS=*

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
TEMPERATURE=0.2
MAX_HISTORY_MESSAGES=4

# DataStax Astra / Cassandra
ASTRA_DB_APP_TOKEN=
ASTRA_DB_ID=
ASTRA_DB_KEYSPACE=
ASTRA_TABLE_NAME=document_qa

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=document_loader

# Storage (local)
UPLOAD_DIR=./uploads

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
